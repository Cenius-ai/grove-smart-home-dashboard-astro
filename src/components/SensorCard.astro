---
import type { SensorSummary } from '../lib/types';

interface Props {
  sensor: SensorSummary;
}

const { sensor } = Astro.props;

const iconPaths: Record<string, string> = {
  thermometer: 'M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z',
  droplets: 'M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z',
  gauge: 'M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41M14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0z',
  wind: 'M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2',
};

const typeColors: Record<string, string> = {
  temperature: '#e67e4a',
  humidity: '#4d77cc',
  pressure: '#7c5cbf',
  airquality: '#43a87c',
};

const iconPath = iconPaths[sensor.icon] ?? iconPaths.thermometer;
const accentColor = typeColors[sensor.type] ?? '#4d77cc';
---

<a
  href={`/sensor/${sensor.id}`}
  class="surface-card group flex flex-col gap-3 p-5 transition-shadow duration-160 hover:shadow-md no-underline"
  style="min-height: 140px;"
>
  <!-- Header row -->
  <div class="flex items-start justify-between">
    <div class="flex items-center gap-2.5">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-btn"
        style="background: {accentColor}15; color: {accentColor};"
        aria-hidden="true"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d={iconPath} />
        </svg>
      </span>
      <div>
        <h3 class="text-sm font-semibold text-[var(--color-fg)] leading-tight">{sensor.name}</h3>
        <p class="text-xs text-[var(--color-muted)]">{sensor.location}</p>
      </div>
    </div>
    <span class={`status-dot ${sensor.status}`} aria-label={sensor.status}></span>
  </div>

  <!-- Value -->
  <div class="mt-1">
    <span class="metric-value text-3xl font-semibold tracking-tight text-[var(--color-fg)]">
      {sensor.currentValue.toFixed(1)}
    </span>
    <span class="ml-1 text-sm text-[var(--color-muted)]">{sensor.unit}</span>
  </div>

  <!-- Footer -->
  <div class="mt-auto flex items-center gap-2 text-xs text-[var(--color-muted)]">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
    </svg>
    <span>Updated {new Date(sensor.lastUpdated).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
  </div>
</a>
