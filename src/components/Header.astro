---
import ThemeToggle from './ThemeToggle.tsx';
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[var(--color-bg)]/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="Grove home">
      <span class="flex h-9 w-9 items-center justify-center rounded-btn bg-[var(--color-accent)] text-[var(--color-accent-fg)]" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
      </span>
      <span class="text-lg font-semibold tracking-tight text-[var(--color-fg)]">Grove</span>
    </a>

    <nav class="flex items-center gap-1" aria-label="Main navigation">
      <a href="/" class="rounded-btn px-3 py-1.5 text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-fg)] hover:bg-[var(--color-border)] transition-colors duration-160">
        Dashboard
      </a>
      <a href="/settings" class="rounded-btn px-3 py-1.5 text-sm font-medium text-[var(--color-muted)] hover:text-[var(--color-fg)] hover:bg-[var(--color-border)] transition-colors duration-160">
        Settings
      </a>
      <div class="ml-2">
        <ThemeToggle client:load />
      </div>
    </nav>
  </div>
</header>
